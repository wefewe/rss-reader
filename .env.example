# Server Settings
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_random_secret_in_production
TZ=Asia/Shanghai

# Database (Default: SQLite in /data/reader.db, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:////data/reader.db

# LLM AxonHub Settings (OpenAI Compatible)
LLM_BASE_URL=http://axonhub:8090/v1
LLM_API_KEY=ah_your_api_key_here
LLM_SUMMARY_MODEL=deepseek-v4.1-flash
LLM_BRIEF_MODEL=gpt-5.6-terra

# Public URL for web & telegram links
PUBLIC_URL=https://reader.example.com

# Auto Refresh Intervals (Minutes)
FEED_REFRESH_INTERVAL_MINUTES=30
DAILY_BRIEF_CRON_HOUR=9
DAILY_BRIEF_CRON_MINUTE=0

# Optional Telegram Push for 09:00 Briefing
TG_BOT_TOKEN=
TG_CHAT_ID=
